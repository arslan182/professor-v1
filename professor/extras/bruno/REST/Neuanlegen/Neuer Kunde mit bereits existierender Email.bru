meta {
  name: Neuer Kunde mit bereits existierender Email
  type: http
  seq: 2
}

post {
  url: {{api_url}}
  body: json
  auth: inherit
}

headers {
  X-Version: 1.0.0
}

body:json {
  {
      "nachname": "Test",
      "email": "admin@acme.com",
      "kategorie": 1,
      "hasNewsletter": true,
      "geburtsdatum": "2024-01-31",
      "homepage": "https://www.test.de",
      "geschlecht": "W",
      "familienstand": "L",
      "adresse": {
          "plz": "12345",
          "ort": "Testort"
      },
      "rechnungen": [{
          "betrag": 0,
          "waehrung": "EUR"
      }],
      "interessen": [
          "R",
          "L"
      ]
  }
}

assert {
  res.status: eq 422
  res.headers['content-type']: eq application/problem+json
  res.body.detail: isString
  res.body.detail: contains Emailadresse
}

settings {
  encodeUrl: true
  timeout: 0
}
