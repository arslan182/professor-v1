meta {
  name: Vorhandene ID 0...1 aber alte API-Version
  type: http
  seq: 4
}

get {
  url: {{api_url}}/:id
  body: none
  auth: inherit
}

params:path {
  id: 00000000-0000-0000-0000-000000000001
}

headers {
  Accept: application/json
  X-Version: 0.9.0
}

assert {
  res.status: eq 400
  res.headers['content-type']: eq application/problem+json
  res.body.detail: contains Invalid API version
}

settings {
  encodeUrl: true
  timeout: 0
}
