@startuml ProfessorWriteController

skinparam classAttributeIconSize 0

package org.springframework {
package stereotype {
        annotation Controller
    }

    package web {
        interface ErrorResponse

        package bind {
            ' TODO Gradle: "exception" wird erst AsciiDoctor_plugin 5.x unterstuetzt
            exception MethodArgumentNotValidException

            package annotation {
                annotation RequestMapping
                annotation PathVariable
                annotation RequestBody
                annotation ExceptionHandler
            }

            RequestMapping .down[hidden].> MethodArgumentNotValidException
            PathVariable .right[hidden].> RequestMapping
            Controller .right[hidden].> PathVariable
        }
    }

    package http {
        class ResponseEntity<T>

        package converter {
            exception HttpMessageNotReadableException
        }
    }
}

package jakarta.servlet.http {
    interface HttpServletRequest

    HttpMessageNotReadableException .down[hidden].> HttpServletRequest
}

package java.util {
    interface Collection<T>
    class UUID

    UUID .up[hidden].> Collection
    Collection .up[hidden].> HttpServletRequest
}

package com.acme.professor {
    package service {
        class ProfessorWriteService << control >> << @Service >>

        exception EmailExistsException
    }
    package rest #DDDDDD {
        ' TODO "record" statt "class" ab v1.2025.4 (Juni 2025)
        ' https://github.com/plantuml/plantuml/commit/b8bb8a72b77ff169807429f70043150d2e380a67
        class ProfessorDTO <<entity>>

        class ProfessorWriteController << boundary >> << @Controller >> << @RequestMapping >> {
            ~ @PostMapping post(@RequestBody ProfessorDTO: ProfessorDTO, request: HttpServletRequest): ResponseEntity<Void>
            ~ @PutMapping put(@PathVariable id: UUID, @RequestBody ProfessorDTO: ProfessorDTO)
            ~ @DeleteMapping deleteById(@PathVariable id: UUID)

            ~ @ExceptionHandler onConstraintViolations(ex: MethodArgumentNotValidException): ErrorResponse
            ~ @ExceptionHandler onEmailExists(ex: EmailExistsException): ErrorResponse
            ~ @ExceptionHandler onMessageNotReadable(ex: HttpMessageNotReadableException): ErrorResponse
        }

        ProfessorWriteController o-down-> "1" ProfessorWriteService : service
        ProfessorWriteController ..> ProfessorDTO
        ProfessorWriteController ..> EmailExistsException

        ProfessorWriteController .up.> ResponseEntity
        ProfessorWriteController .up.> ErrorResponse
        ProfessorWriteController .up.> HttpMessageNotReadableException
        ProfessorWriteController .left.> HttpServletRequest

        ProfessorWriteController .up.> Controller
        ProfessorWriteController .up.> RequestMapping
        ProfessorWriteController .up.> PathVariable
        ProfessorWriteController .up.> RequestBody
        ProfessorWriteController .up.> ExceptionHandler
        ProfessorWriteController .up.> MethodArgumentNotValidException

        ProfessorWriteController .right.> UUID
        ProfessorWriteController .right.> Collection

        ProfessorDTO .[hidden].> ProfessorWriteService
    }
}

hide empty members

footer (c) Ali Arslan

@enduml
