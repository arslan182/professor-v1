@startuml ProfessorController

skinparam classAttributeIconSize 0

package org.springframework {
    package web.bind.annotation {
        annotation RestController
        annotation RequestMapping
        annotation PathVariable
        annotation RequestParam
        annotation ExceptionHandler
        annotation ResponseStatus
    }

    package http {
        class ResponseEntity<T>
    }
    package util {
        class MultiValueMap<K,V>
    }
}

package java.util {
    interface Collection
    class UUID
}

package com.acme.professor {
    package entity {
        class Professor
    }
    package service {
        class ProfessorService << control >> << @Service >>

        ' TODO Gradle: "exception" wird erst AsciiDoctor_plugin 5.x unterstuetzt
        exception NotFoundException

        ProfessorService .right[hidden].> Professor
    }

    package rest #DDDDDD {
        class ProfessorController << boundary >> << @RestController >> << @RequestMapping >> {
            ~ @GetMapping getById(@PathVariable id: UUID): Professor
            ~ @GetMapping get(@RequestParam queryParams: MultiValueMap<String, String>): Collection<Professor>
        }

        class GlobalExceptionHandler << @ControllerAdvice >> {
            ~ @ExceptionHandler @ResponseStatus onNotFound(ex: NotFoundException)
        }

        ProfessorController o--> "1" ProfessorService : service

        ProfessorController .up.> RestController
        ProfessorController .up.> RequestMapping
        ProfessorController .up.> PathVariable
        ProfessorController .up.> RequestParam
        ProfessorController .up.> ResponseEntity
        ProfessorController .up.> MultiValueMap
        ProfessorController .down.> Professor

        GlobalExceptionHandler .up.> ExceptionHandler
        GlobalExceptionHandler .up.> ResponseStatus
        GlobalExceptionHandler ..> NotFoundException

        ProfessorController .right.> UUID
        ProfessorController ..> Collection
    }
}

hide empty members

footer (c) Ali Arslan

@enduml
